    "flight.landedWhileAway.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the ticket"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bileti gör"
          }
        }
      }
    },
    "flight.landedWhileAway.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole flight counted. Your stamp is in the passport."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uçuşun tamamı sayıldı. Damganız pasaportta."
          }
        }
      }
    },
    "flight.landedWhileAway.openEnded.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time counted. Your stamp is in the passport."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Süreniz sayıldı. Damganız pasaportta."
          }
        }
      }
    },
